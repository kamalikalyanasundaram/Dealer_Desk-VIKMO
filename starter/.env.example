# Copy to .env and replace placeholders with local development values.
# Never commit .env or use these placeholders as real credentials.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/dealerdesk
SUPPLIER_API_URL=http://127.0.0.1:8099
SUPPLIER_API_KEY=replace-with-supplier-api-key
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=1

# Your LLM provider's key (only the one you use): Gemini, OpenAI, Anthropic or Groq
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
