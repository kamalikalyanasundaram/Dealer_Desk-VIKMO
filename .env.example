# Copy to .env for local development; never commit .env or real secrets.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/dealerdesk
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=1
SUPPLIER_API_URL=http://127.0.0.1:8099
SUPPLIER_API_KEY=replace-with-supplier-api-key

# Optional: set only if implementing the assistant.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=